meta {
  name: webhook
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/webhook
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "event_id": "abc-123",
    "type": "payment_succeeded",
    "payload": {
      "amount": 10
    }
  }
}

tests {
  test("new event is queued", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.status).to.equal("queued");
  });
}
